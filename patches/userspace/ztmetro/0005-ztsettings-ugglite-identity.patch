 #define HW_S9_BACKLIGHT	"/sys/class/backlight/s9p-panel"
 #define HW_S9_GPU	"/sys/class/devfreq/17500000.gpu"
 
+/* ugglite's, used when /etc/ztos/device names it (as ztdevices reads it):
+ * TI BQ27426 gauge, the panel's own backlight device, Adreno 308 devfreq. */
+#define HW_UG_BATTERY	"/sys/class/power_supply/bq27426-0"
+#define HW_UG_BACKLIGHT	"/sys/class/backlight/1a94000.dsi.0"
+#define HW_UG_GPU	"/sys/class/devfreq/1c00000.gpu"
+
+static inline bool hw_is_ugglite(void)
+{
+	static int known = -1;
+	char line[64] = "";
+	if (known < 0) {
+		FILE *f = fopen("/etc/ztos/device", "r");
+		if (f) {
+			if (fgets(line, sizeof(line), f))
+				line[strcspn(line, "\r\n")] = 0;
+			fclose(f);
+		}
+		known = strcmp(line, "xiaomi-ugglite") == 0;
+	}
+	return known;
+}
