+/* The board this build runs on: /etc/ztos/device names it, the way ztdevices
+ * (../devices/ztdevices.c) reads it. Without the file every page keeps the S9's
+ * identity, so a build that runs on an S9 is unchanged. */
+static bool is_ugglite(void) {
+	static int known = -1;
+	char line[64] = "";
+	if (known < 0) {
+		FILE *f = fopen("/etc/ztos/device", "r");
+		if (f) {
+			if (fgets(line, sizeof(line), f))
+				line[strcspn(line, "\r\n")] = 0;
+			fclose(f);
+		}
+		known = strcmp(line, "xiaomi-ugglite") == 0;
+	}
+	return known;
+}
