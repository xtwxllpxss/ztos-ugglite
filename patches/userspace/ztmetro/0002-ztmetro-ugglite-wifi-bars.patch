+/* ---- the Wi-Fi strength, asked of NetworkManager off the drawing path ----- */
+
+#define WIFI_ASK_MS	15000	/* how often NetworkManager is asked, while linked */
+#define WIFI_KEEP_MS	45000	/* a reading older than this is not shown at all */
+#define WIFI_NM_TIMEOUT_MS 1200	/* nmcli gets no longer than this to answer */
+
+/* How many of the fan's bands a strength fills: defined below, with the cuts. */
+static int wifi_bars_of_pct(int pct);
+static void draw_status(struct zt_server *server);
+
+/*
+ * One worker thread owns the only call to nmcli; the drawing code reads what it
+ * last published and never waits. Same shape as the backlight's thread: a mutex,
+ * a cond var, and an eventfd that tells the loop a reading has landed. Nothing
+ * here is started unless the fd and the thread both came up.
+ */
+static struct {
+	pthread_mutex_t lock;
+	pthread_cond_t wake;
+	int ask;		/* set by the loop: read once, now */
+	int up;			/* the carrier, as the last tick saw it */
+	int pct;		/* the strength last read, -1 none */
+	uint32_t pct_ms;	/* when it was read (CLOCK_MONOTONIC), 0 never */
+	uint32_t ask_ms;	/* when the worker was last asked (0 never) */
+	int fd;			/* eventfd: a reading has landed */
+	int usable;
+	struct zt_server *server;
+} wf = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, 0, 0, -1, 0, 0, -1, 0, NULL };
+
+/* The strength of the link in use, as NetworkManager has it: the one line of
+ * `nmcli -t -f IN-USE,SIGNAL device wifi list` that starts with '*'. The child
+ * is killed when it has not answered within WIFI_NM_TIMEOUT_MS, so a stuck
+ * nmcli cannot hold the worker; this is the only place a program is run for
+ * the signal, and it is never the loop's thread. */
+static bool wifi_nm_ask(int *pct) {
+	int fds[2];
+	if (pipe2(fds, O_CLOEXEC) != 0) {
+		return false;
+	}
+	pid_t child = fork();
+	if (child == 0) {
+		/* the loop's signalfd owns the signals: none are wanted here */
+		sigset_t none;
+		sigemptyset(&none);
+		sigprocmask(SIG_SETMASK, &none, NULL);
+		int null = open("/dev/null", O_RDWR);
+		if (null >= 0) {
+			dup2(null, 2);
+		}
+		dup2(fds[1], 1);
+		execlp("nmcli", "nmcli", "-t", "-f", "IN-USE,SIGNAL", "device", "wifi", "list", (char *)NULL);
+		_exit(127);
+	}
+	close(fds[1]);
+	if (child < 0) {
+		close(fds[0]);
+		return false;
+	}
+	char buf[1024];
+	size_t len = 0;
+	bool eof = false;
+	struct pollfd pfd = { .fd = fds[0], .events = POLLIN };
+	while (len < sizeof(buf) - 1) {
+		int r = poll(&pfd, 1, WIFI_NM_TIMEOUT_MS);
+		if (r <= 0) {
+			break;
+		}
+		ssize_t n = read(fds[0], buf + len, sizeof(buf) - 1 - len);
+		if (n > 0) {
+			len += (size_t)n;
+		} else if (n == 0) {
+			eof = true;
+			break;
+		} else if (errno != EINTR) {
+			break;
+		}
+	}
+	close(fds[0]);
+	if (!eof) {
+		kill(child, SIGKILL);	/* out of time, or out of buffer */
+		wlr_log(WLR_DEBUG, "wifi: nmcli gave no answer within %d ms", WIFI_NM_TIMEOUT_MS);
+	}
+	buf[len] = 0;
+	bool found = false;
+	for (char *line = buf; line && *line;) {
+		char *nl = strchr(line, '\n');
+		if (nl) {
+			*nl = 0;
+		}
+		if (line[0] == '*' && line[1] == ':') {	/* "*:72" is the one in use */
+			int v = atoi(line + 2);
+			if (v >= 0 && v <= 100) {
+				*pct = v;
+				found = true;
+			}
+			break;
+		}
+		line = nl ? nl + 1 : NULL;
+	}
+	return found;
+}
+
+static void *wifi_thread(void *data) {
+	for (;;) {
+		pthread_mutex_lock(&wf.lock);
+		while (!wf.ask) {
+			pthread_cond_wait(&wf.wake, &wf.lock);
+		}
+		wf.ask = 0;
+		int up = wf.up;
+		pthread_mutex_unlock(&wf.lock);
+		int pct = -1;
+		bool got = up && wifi_nm_ask(&pct);
+		uint32_t at = now_ms();
+		pthread_mutex_lock(&wf.lock);
+		if (got) {
+			wf.pct = pct;
+			wf.pct_ms = at ? at : 1;
+		} else if (!up) {
+			wf.pct = -1;
+			wf.pct_ms = 0;
+		}
+		pthread_mutex_unlock(&wf.lock);
+		uint64_t one = 1;
+		if (wf.fd >= 0 && write(wf.fd, &one, sizeof(one)) < 0) {}
+	}
+	return NULL;
+}
+
+/* Once a second from the loop, while the screen is on: keeps the link state
+ * current and asks for a reading once the last one is WIFI_ASK_MS old. Nothing
+ * is asked while there is no link. */
+static void wifi_tick(void) {
+	bool up = wifi_up();
+	uint32_t now = now_ms();
+	pthread_mutex_lock(&wf.lock);
+	wf.up = up;
+	if (!up) {
+		wf.pct = -1;
+		wf.pct_ms = 0;
+	} else if (wf.usable && !wf.ask && (!wf.ask_ms || now - wf.ask_ms >= WIFI_ASK_MS)) {
+		/* gated on when it was asked, not on when it last answered: a
+		 * failed or killed nmcli must not turn this into one run a second */
+		wf.ask_ms = now ? now : 1;
+		wf.ask = 1;
+		pthread_cond_signal(&wf.wake);
+	}
+	pthread_mutex_unlock(&wf.lock);
 }
 
+/* The last reading, as the drawing code may have it: -1 no link, 0 linked but
+ * no strength worth showing. Never blocks, never starts a program. */
+static int wifi_sig_bars(void) {
+	uint32_t now = now_ms();
+	int bars;
+	pthread_mutex_lock(&wf.lock);
+	if (!wf.up) {
+		bars = -1;
+	} else if (wf.pct >= 0 && wf.pct_ms && now - wf.pct_ms < WIFI_KEEP_MS) {
+		bars = wifi_bars_of_pct(wf.pct);
+	} else {
+		bars = 0;
+	}
+	pthread_mutex_unlock(&wf.lock);
+	return bars;
+}
+
+/* The link is gone now, whatever was last measured (radio off, sleep). */
+static void wifi_forget(void) {
+	pthread_mutex_lock(&wf.lock);
+	wf.up = 0;
+	wf.pct = -1;
+	wf.pct_ms = 0;
+	if (wf.server) {
+		/* the daemon's report is a reading too: radio off clears it, or the
+		 * fan would be drawn from it for up to 40 s */
+		wf.server->wifi_bars = -1;
+		wf.server->wifi_read_ms = 0;
+	}
+	pthread_mutex_unlock(&wf.lock);
+}
+
+static int wifi_read_landed(int fd, uint32_t mask, void *data) {
+	struct zt_server *server = data;
+	uint64_t n;
+	if (read(fd, &n, sizeof(n)) < 0) {}
+	if (server->width > 0) {
+		draw_status(server);
+		damage(server);
+	}
+	return 0;
+}
+
+static void wifi_sig_init(struct zt_server *server) {
+	wf.server = server;
+	wf.fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+	if (wf.fd < 0) {
+		wlr_log(WLR_ERROR, "wifi: no eventfd, the strength stays unknown");
+		return;
+	}
+	/* the thread takes no signals, as the backlight's does not */
+	sigset_t all, old;
+	sigfillset(&all);
+	pthread_sigmask(SIG_BLOCK, &all, &old);
+	pthread_t thread;
+	bool started = pthread_create(&thread, NULL, wifi_thread, NULL) == 0;
+	if (started) {
+		pthread_detach(thread);
+	}
+	pthread_sigmask(SIG_SETMASK, &old, NULL);
+	if (!started) {
+		return;
+	}
+	if (!wl_event_loop_add_fd(server->loop, wf.fd, WL_EVENT_READABLE, wifi_read_landed, server)) {
+		/* no source in the loop means no redraw ever: do not ask at all, and
+		 * leave usable 0 so no stale value is drawn either */
+		wlr_log(WLR_ERROR, "wifi: no event source, the strength stays unknown");
+		close(wf.fd);
+		wf.fd = -1;
+		return;		/* usable stays 0: nothing is asked, no stale redraw */
+	}
+	pthread_mutex_lock(&wf.lock);
+	wf.usable = 1;
+	pthread_mutex_unlock(&wf.lock);
+}
