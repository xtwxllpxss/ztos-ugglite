+/* How many of the fan's three bands a strength fills. ztsettings' four arcs
+ * cut at 75, 55 and 35 %, so on its scale the top quarter of the circle is
+ * 75..100. The fan has one band fewer and is not a percentage readout: its
+ * top band is that same 75..100 (full), and the settings' next two bands
+ * (55 and 35) share the one below. A link whose strength is unknown is 0,
+ * the glyph with no band lit — never a full one. */
+static int wifi_bars_of_pct(int pct) {
+	return pct >= 75 ? 3 : pct >= 35 ? 2 : pct > 0 ? 1 : 0;
