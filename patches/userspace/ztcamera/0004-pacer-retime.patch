+/*
+ * The recorder's timeline. The pacer writes frames at REC_FPS whatever the
+ * encoder keeps up with: slots it cannot afford are counted in rec_skipped and
+ * not written (REC_FILL_SLOTS caps the burst so a stalled encoder cannot block
+ * the viewfinder in frame_arrived). The mkv therefore holds written/REC_FPS
+ * seconds - for real 720p30 that was 6.5 s of file for 10.6 s of recording,
+ * which plays 1.6x fast. The encoder cannot be made to take 30 fps on this SoC,
+ * so the file's timeline is fixed once the encoder is done, from the only clock
+ * that saw the whole recording - the wall clock: the live file's timestamps are
+ * scaled by wall/file with a stream copy. Nothing is re-encoded and no frame is
+ * added or dropped; the same frames are shown over the time they were shot.
+ * Returns true when the live file was traded for the retimed one.
+ */
+static bool record_retime(const char *live, const char *out, double factor) {
+	char scale[32], tmp[sizeof(ui.rec_path) + 8];
+	snprintf(scale, sizeof(scale), "%.6f", factor);
+	snprintf(tmp, sizeof(tmp), "%s.retime", out);
+	pid_t pid = fork();
+	if (pid == 0) {
+		execlp("ffmpeg", "ffmpeg", "-nostdin", "-loglevel", "error", "-y",
+			"-itsscale", scale, "-i", live, "-c", "copy",
+			"-f", "matroska", tmp, (char *)NULL);
+		_exit(127);
+	}
+	if (pid < 0) {
+		return false;
+	}
+	int status = 0;
+	for (int waited = 0; waited < 8000; waited += 20) {
+		pid_t done = waitpid(pid, &status, WNOHANG);
+		if (done == pid) {
+			if (WIFEXITED(status) && WEXITSTATUS(status) == 0 &&
+			    rename(tmp, out) == 0) {
+				unlink(live);
+				return true;
+			}
+			unlink(tmp);
+			return false;
+		}
+		if (done < 0 && errno != EINTR) {
+			return false;
+		}
+		usleep(20000);
+	}
+	kill(pid, SIGKILL);
+	while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+	unlink(tmp);
+	return false;
+}
+
 static void record_stop(const char *why) {
 	if (!ui.recording) return;
+	uint32_t wall_ms = zmc_now_ms() - ui.rec_start;
 	ui.recording = false;
 	close(ui.rec_fd);
 	ui.rec_fd = -1;
@@ -2596,6 +2655,30 @@
 		"%u skipped, worst frame write %u ms\n", ui.rec_path, ui.rec_written,
 		(double)ui.rec_written / REC_FPS, REC_FPS, ui.rec_repeated, ui.rec_skipped,
 		ui.rec_worst_ms);
+	/* The skipped slots are recording time the container does not have:
+	 * stretch the file's timestamps to the wall clock it was shot by. One
+	 * frame at the end keeps its own duration, so the timeline is
+	 * (written - 1) frame periods to scale, the first one to keep. */
+	char live[sizeof(ui.rec_path) + 8];
+	snprintf(live, sizeof(live), "%s.part", ui.rec_path);
+	double frame_ms = 1000.0 / REC_FPS;
+	double nominal_ms = (double)ui.rec_written * frame_ms;
+	double factor = 1.0;
+	if (ui.rec_written >= 2) {
+		factor = ((double)wall_ms - frame_ms) / (nominal_ms - frame_ms);
+	}
+	bool retimed = false;
+	if (factor > 0.5 && fabs(factor - 1.0) > 0.02) {
+		retimed = record_retime(live, ui.rec_path, factor);
+		if (retimed) {
+			fprintf(stderr, "ztcamera: video retimed: %.2f s of file at %d fps -> "
+				"%.2f s of wall clock (x%.4f)\n", nominal_ms / 1000.0, REC_FPS,
+				(double)wall_ms / 1000.0, factor);
+		}
+	}
+	if (!retimed && rename(live, ui.rec_path) != 0) {
+		note("video file: %s", strerror(errno));
+	}
 	roll_scan();
 	if (result > 0 && WIFEXITED(status) && WEXITSTATUS(status) == 0)
 		note("%s: %s", why ? why : "recorded", ui.rec_path);
