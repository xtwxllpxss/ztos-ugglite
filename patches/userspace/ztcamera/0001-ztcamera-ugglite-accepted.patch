+/* ---- the recorder's frame, scaled once before the pipe
+ *
+ * The pipe, not the encoder, was the bottleneck at 1280x720: BGRA at 24 fps is
+ * 86 MB/s through a 212992-byte socket and could not drain, so the encoder was
+ * fed 42 frames over 4 s of life stamped at 15 fps and the clip ran 2.8 s.
+ * The frame is therefore scaled here, once, by one area-average box into the
+ * size the pipe can carry, and the encoder is fed exactly that. Two builds
+ * share this code: REC_SCALE_NUM/DEN = 3/4 with REC_FPS 24 writes 540x960
+ * (49.8 MB/s of BGRA), 1/1 with REC_FPS 15 writes the full 720x1280
+ * (55.3 MB/s). Both keep the same pacer: a late frame is repeated to fill the
+ * clock, never dropped, so a clip of N seconds plays N seconds.
+ */
+static uint8_t *rec_buf;
+static size_t rec_cap;
+static int rec_w, rec_h;
+static int *rec_xmap, *rec_ymap;	/* rec_w+1 / rec_h+1 source edges */
+
+static size_t rec_stride(void) { return (size_t)rec_w * 4; }
+
+static bool rec_alloc(void) {
+	int w = src.w, h = src.h;
+	if (src.kind == SRC_RAW) {
+		/* the raw readback does its own 2x2 box into the half-size buffer */
+		w = src.w & ~1;
+		h = src.h & ~1;
+		if (w >= 128 && h >= 128) {
+			w /= 2;
+			h /= 2;
+		}
+	} else if (REC_SCALE_NUM != REC_SCALE_DEN) {
+		w = (int)((long)src.w * REC_SCALE_NUM / REC_SCALE_DEN) & ~1;
+		h = (int)((long)src.h * REC_SCALE_NUM / REC_SCALE_DEN) & ~1;
+		if (w < 64 || h < 64) {
+			w = src.w & ~1;	/* a tiny source is not worth scaling */
+			h = src.h & ~1;
+		}
+	} else {
+		w = src.w & ~1;
+		h = src.h & ~1;
+	}
+	if (w > src.w) {
+		w = src.w & ~1;
+	}
+	if (h > src.h) {
+		h = src.h & ~1;
+	}
+	size_t need = (size_t)w * h * 4;
+	if (!rec_buf || need > rec_cap) {
+		uint8_t *grown = realloc(rec_buf, need);
+		if (!grown) {
+			return false;
+		}
+		rec_buf = grown;
+		rec_cap = need;
+	}
+	rec_w = w;
+	rec_h = h;
+	int *xmap = NULL, *ymap = NULL;
+	if (src.kind != SRC_RAW && (w != src.w || h != src.h)) {
+		xmap = realloc(rec_xmap, (size_t)(w + 1) * sizeof(int));
+		ymap = realloc(rec_ymap, (size_t)(h + 1) * sizeof(int));
+		if (!xmap || !ymap) {
+			rec_xmap = xmap ? xmap : rec_xmap;
+			rec_ymap = ymap ? ymap : rec_ymap;
+			return false;
+		}
+		rec_xmap = xmap;
+		rec_ymap = ymap;
+		for (int x = 0; x <= w; x++) {
+			rec_xmap[x] = (int)((long)x * src.w / w);
+		}
+		for (int y = 0; y <= h; y++) {
+			rec_ymap[y] = (int)((long)y * src.h / h);
+		}
+	}
+	return true;
