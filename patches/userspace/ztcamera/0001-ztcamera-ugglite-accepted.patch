+/*
+ * The recorder's clock. One frame per 1/REC_FPS of wall clock; when the clock
+ * has slipped, the prepared frame is repeated to fill the gap - repeated, not
+ * dropped, because a dropped frame at a fixed input rate shortens the clip and
+ * a shorter clip plays faster than the recording did. A slip longer than
+ * REC_FILL_SLOTS is not flushed as one burst (that would stall the viewfinder
+ * in frame_arrived): the schedule is re-phased and the slots are counted, so
+ * the log shows a dead encoder instead of silent fast motion.
+ */
+static bool record_tick(void) {
+	uint32_t now = zmc_now_ms();
+	if ((int32_t)(now - ui.rec_next) < 0) {
+		return true;	/* not this frame's turn: dropped, never queued */
+	}
+	unsigned slots = (unsigned)((now - ui.rec_next) / REC_PERIOD_MS) + 1;
+	if (slots > REC_FILL_SLOTS) {
+		ui.rec_skipped += slots - REC_FILL_SLOTS;
+		slots = REC_FILL_SLOTS;
+	}
+	if (!record_frame_prepare()) {
+		record_stop("no frame to write");
+		return false;
+	}
+	size_t len = rec_stride() * (size_t)rec_h;
+	for (unsigned i = 0; i < slots; i++) {
+		uint32_t began = zmc_now_ms();
+		if (!record_write(rec_buf, len)) {
+			record_stop("encoder stalled");
+			return false;
+		}
+		uint32_t took = zmc_now_ms() - began;
+		if (took > ui.rec_worst_ms) {
+			ui.rec_worst_ms = took;
+		}
+		ui.rec_written++;
+		if (i) {
+			ui.rec_repeated++;
+		}
+	}
+	now = zmc_now_ms();
+	ui.rec_next += slots * REC_PERIOD_MS;
+	if ((int32_t)(now - ui.rec_next) >= 0) {	/* still behind: drop the debt */
+		ui.rec_skipped += (now - ui.rec_next) / REC_PERIOD_MS + 1;
+		ui.rec_next = now + REC_PERIOD_MS;
+	}
+	if (now - ui.rec_start >= REC_MAX_MS) {
+		record_stop("time limit reached");
+		return false;
+	}
+	return true;
+}
