+/* The contrast sweep: a tap on the viewfinder, with no menu or dial on the
+ * screen, walks the lens over the control's range in two short passes. The
+ * coarse pass takes FOCUS_COARSE_STEPS positions from minimum to maximum; the
+ * fine pass then re-visits half a coarse interval either side of the sharpest
+ * coarse position in FOCUS_FINE_STEPS moves (about four times finer). Each
+ * position is given FOCUS_SETTLE_MS to settle, then one frame of the middle of
+ * the picture is scored by its Tenengrad (Sobel) detail, the sharpest is kept,
+ * the parabola through its two neighbours puts the lens between samples, and
+ * the lens is left there. A fixed number of moves, no feedback loop: 14
+ * positions, about 1.8-2.1 s, and a stalled frame clock ends it by timeout
+ * rather than leaving it running. */
+#define FOCUS_COARSE_STEPS	7	/* the range in a few moves, enough to find the hill */
+#define FOCUS_FINE_STEPS	7	/* then four times finer around the coarse best */
+#define FOCUS_SETTLE_MS		110	/* lens and exposure settle before a frame counts */
+#define FOCUS_SWEEP_TIMEOUT_MS	6000	/* the whole two-stage sweep, not one position */
+#define FOCUS_REGION		0.60	/* the middle of the frame, as a fraction */
+#define FOCUS_FINE_SPAN		0.55	/* fine half-window, in coarse intervals */
+
+static struct {
+	bool active;
+	bool automatic;		/* started by the AF monitor, not by a finger */
+	int stage;		/* 0: coarse over the range, 1: fine around the best */
+	int idx;		/* the position being settled, 0-based */
+	int pos[FOCUS_COARSE_STEPS + FOCUS_FINE_STEPS];	/* in control steps */
+	double ten[FOCUS_COARSE_STEPS + FOCUS_FINE_STEPS];	/* detail at each position */
+	double norm[FOCUS_COARSE_STEPS + FOCUS_FINE_STEPS];	/* the same, exposure-normalised */
+	int npos;
+	int coarse_best;	/* the sharpest coarse step: the fine window's centre */
+	double coarse_best_score;
+	unsigned bad;		/* unusable frames in a row at this position */
+	uint32_t started, deadline;
+} sweep;
+
+/* Auto focus on the live V4L2 path: one sweep when the source opens, then a
+ * re-sweep when the picture has really softened for a while, and immediately
+ * when the scene itself changes. A full continuous hill climb would move the
+ * lens every FOCUS_SETTLE_MS and hunt visibly; a sweep and a deadband is the
+ * same contrast score without the hunting and without scoring every frame.
+ * The focus dial and a tap still own the lens: a dial choice turns this off, a
+ * tap runs its own sweep and re-baselines this one. */
+#define AF_INITIAL_MS		1200	/* exposure first: a dark frame scores noise as sharp */
+#define AF_CHECK_MS		2000	/* how often the settled picture is scored */
+#define AF_LOW_FRACTION		0.60	/* falls this far below the focused score ... */
+#define AF_LOW_MS		2000	/* ... for this long before a sweep */
+#define AF_RETRY_MS		6000	/* after a pause this long, re-check a soft picture */
+#define AF_PERIOD_FRACTION	0.85
+#define AF_MIN_GAP_MS		3000	/* never two automatic monitor sweeps closer than this */
+
+/* A different subject does not soften gradually: the luma histogram changes in
+ * one or two frames. That is a stronger and much faster signal than waiting for
+ * the contrast score to fall 40 % for 2 s, so a confirmed scene change runs
+ * AF-S almost at once. Two consecutive frames and a minimum gap keep sensor
+ * noise, a flickering lamp and our own lens move from triggering it. */
+#define AF_SCENE_BINS		16
+#define AF_SCENE_HIST_DIST	0.34	/* L1/2 of the normalised luma histogram */
+#define AF_SCENE_MEAN_FRAC	0.16	/* mean jump as a fraction of black..white */
+#define AF_SCENE_CONFIRM_MS	45	/* two frames at 30 fps is 33 ms */
+#define AF_SCENE_MIN_GAP_MS	900
+
+/* Below black+24 a raw frame is mostly sensor noise and a Tenengrad score can
+ * pick noise as "sharp". Exposure and gain are raised first (see af_boost);
+ * only if that still leaves the frame under black+10 does a sweep refuse. When
+ * even that fails, the attempt is logged and not repeated for this long: no
+ * hunting in a dark room, but a light switched on is noticed via the luma
+ * change and retried at once. */
+#define AF_DARK_RETRY_MS	15000
+#define AF_BOOST_SETTLE_MS	280	/* the sensor lags two frames; score after this */
+
+static struct {
+	bool enabled;		/* a lens was found with this source */
+	bool manual;		/* the focus dial has taken the lens */
+	bool primed;		/* the opening sweep has been started */
+	bool low;		/* past the deadband: the picture is soft */
+	bool scene;		/* a confirmed scene change wants AF-S */
+	uint32_t since;		/* when the source opened */
+	uint32_t last;		/* when the last automatic sweep started */
+	uint32_t next;		/* when to look at the sharpness next */
+	double held;		/* normalised sharpness the last sweep settled on */
+	uint32_t low_since;
+	uint32_t dark_fail_until;	/* no automatic sweep before this after a dark failure */
+} afc;
+
+static struct {
