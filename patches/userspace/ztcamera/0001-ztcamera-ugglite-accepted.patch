+/* The two proven capture nodes. The setup service (ugglite-camera-paths) keeps
+ * both media routes enabled, so an in-process switch only closes one V4L2 fd
+ * and opens the other; the window, the UI and this process stay alive. The
+ * node numbers are not assumed to be stable: /run/ugglite-camera-paths, written
+ * by that service from the media topology, names both. */
+#define CAMERA_PATHS_RUN	"/run/ugglite-camera-paths"
+#define CAMERA_PATHS_ETC	"/etc/ugglite-camera-paths"
+static char rear_dev[64] = "/dev/video0";
+static char front_dev[64] = "/dev/video1";
+static bool paths_mapped;	/* /run or /etc named the nodes explicitly */
+/* The front launcher passes --front; the proven front CAPTURE node is
+ * msm_vfe0_video1. Both mean the same thing here: the sensor is mounted upside
+ * down. */
+static bool front_cam;
+
+static bool path_is_video(const char *p) {
+	size_t n;
+	if (!p || strncmp(p, "/dev/video", 10) != 0 || !p[10]) {
+		return false;
+	}
+	n = strlen(p + 10);
+	return strspn(p + 10, "0123456789") == n;
+}
+
+static void camera_paths_load(void) {
+	const char *files[] = { CAMERA_PATHS_RUN, CAMERA_PATHS_ETC };
+	for (size_t i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		FILE *f = fopen(files[i], "r");
+		if (!f) {
+			continue;
+		}
+		char line[128];
+		while (fgets(line, sizeof(line), f)) {
+			char *nl = strchr(line, '\n');
+			if (nl) {
+				*nl = 0;
+			}
+			if (!strncmp(line, "REAR=", 5) && path_is_video(line + 5)) {
+				snprintf(rear_dev, sizeof(rear_dev), "%s", line + 5);
+				paths_mapped = true;
+			} else if (!strncmp(line, "FRONT=", 6) && path_is_video(line + 6)) {
+				snprintf(front_dev, sizeof(front_dev), "%s", line + 6);
+				paths_mapped = true;
+			}
+		}
+		fclose(f);
+		break;	/* /run wins over /etc when both exist */
+	}
+}
+
+static bool is_front(void) {
+	if (front_cam) {
+		return true;
+	}
+	if (paths_mapped) {
+		return device_path && !strcmp(device_path, front_dev);
+	}
+	/* no mapping: the proven front node was video1 in the known boots */
+	return device_path && !strcmp(device_path, "/dev/video1");
+}
 
