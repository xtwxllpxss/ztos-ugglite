+static bool record_write(const uint8_t *data, size_t len) {
+	uint32_t deadline = zmc_now_ms() + REC_WRITE_MS;
+	while (len) {
+		ssize_t got = send(ui.rec_fd, data, len, MSG_NOSIGNAL | MSG_DONTWAIT);
+		if (got > 0) {
+			data += got;
+			len -= (size_t)got;
+			continue;
+		}
+		if (got < 0 && errno == EINTR) continue;
+		if (got < 0 && errno != EAGAIN && errno != EWOULDBLOCK) return false;
+		int left = (int)(deadline - zmc_now_ms());
+		if (left <= 0) return false;
+		struct pollfd writable = { .fd = ui.rec_fd, .events = POLLOUT };
+		int n = poll(&writable, 1, left);
+		if (n < 0 && errno != EINTR) return false;
+		if (n > 0 && (writable.revents & (POLLERR | POLLHUP | POLLNVAL))) return false;
+	}
+	return true;
+}
