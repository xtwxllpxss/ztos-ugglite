+/* The sources that already have the picture in src.frame (test scene, replay
+ * file, V4L2 node): BGRA in cairo's memory order, one area-average box from
+ * the picture to the recorder's size. Whole copies take the memcpy path. */
+static void frame_scale(void) {
+	const uint8_t *d = (const uint8_t *)cairo_image_surface_get_data(src.frame);
+	int st = cairo_image_surface_get_stride(src.frame);
+	cairo_surface_flush(src.frame);
+	if (rec_w == src.w && rec_h == src.h) {
+		for (int y = 0; y < rec_h; y++) {
+			memcpy(rec_buf + (size_t)y * rec_stride(), d + (size_t)y * st, rec_stride());
+		}
+		return;
+	}
+	for (int y = 0; y < rec_h; y++) {
+		int sy0 = rec_ymap[y], sy1 = rec_ymap[y + 1];
+		uint32_t *o = (uint32_t *)(rec_buf + (size_t)y * rec_stride());
+		for (int x = 0; x < rec_w; x++) {
+			int sx0 = rec_xmap[x], sx1 = rec_xmap[x + 1];
+			uint32_t r = 0, g = 0, b = 0;
+			int n = 0;
+			for (int sy = sy0; sy < sy1; sy++) {
+				const uint32_t *row = (const uint32_t *)(d + (size_t)sy * st);
+				for (int sx = sx0; sx < sx1; sx++) {
+					uint32_t p = row[sx];
+					r += (p >> 16) & 0xff;
+					g += (p >> 8) & 0xff;
+					b += p & 0xff;
+					n++;
+				}
+			}
+			if (n == 0) {
+				n = 1;
+			}
+			if (n == 4) {
+				r = (r + 2) >> 2; g = (g + 2) >> 2; b = (b + 2) >> 2;
+			} else if (n == 2) {
+				r = (r + 1) >> 1; g = (g + 1) >> 1; b = (b + 1) >> 1;
+			} else if (n != 1) {
+				r /= (uint32_t)n; g /= (uint32_t)n; b /= (uint32_t)n;
+			}
+			o[x] = 0xff000000u | r << 16 | g << 8 | b;
+		}
+	}
