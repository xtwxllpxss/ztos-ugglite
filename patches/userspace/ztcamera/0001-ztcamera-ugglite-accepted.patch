+		was_path ? was_path : "none", want);
+	source_start(SRC_V4L2);
+	if (src.kind == SRC_V4L2 && src.fd >= 0) {
+		ui.facing_ms = zmc_now_ms();
+		note("%s camera", want_front ? "front" : "rear");
+		chrome_redraw_mark();
+		return;
+	}
+	/* put the old node back: the user keeps a picture, not a black window */
+	fprintf(stderr, "ztcamera: switch to %s failed; back to %s\n",
+		want, was_path ? was_path : "test scene");
