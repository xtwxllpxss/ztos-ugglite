+/* Front/rear on the live graph is an in-process switch. The setup service
+ * (ugglite-camera-paths, run at boot or once by hand) leaves BOTH CAMSS routes
+ * enabled and formatted:
+ *   rear  csiphy0 -> csid0 -> ispif0 -> vfe0_rdi0 -> video node
+ *   front csiphy1 -> csid1 -> ispif1 -> vfe0_rdi1 -> video node
+ * and writes their node names to /run/ugglite-camera-paths. So this process
+ * only closes the current V4L2 fd and opens the other node: no _exit, no
+ * launcher, no window restart, and the UI (dials, note, recording state) is
+ * the same window throughout. The privileged media-link setup is never done
+ * by the app; the helpers remain for capture, fallback and desktop use. */
+#define FACING_DEBOUNCE_MS	700
+#define FACING_SWITCH_SETTLE_MS	450
+
+static bool facing_deaf(void) {
+	return ui.started_ms &&
+		(uint32_t)(zmc_now_ms() - ui.started_ms) < FACING_DEBOUNCE_MS;
+}
+
+static bool facing_settling(void) {
