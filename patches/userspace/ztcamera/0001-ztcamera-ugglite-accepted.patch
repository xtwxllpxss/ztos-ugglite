+		return;
+	}
+	if (device_path && !strcmp(device_path, want)) {
+		/* the path is already the one the button asks for */
+		front_cam = want_front;
+		ui.front = want_front;
+		return;
+	}
+	if (access(want, R_OK | W_OK) != 0) {
+		note("camera: %s is not ready (%s)", want, strerror(errno));
+		return;
+	}
