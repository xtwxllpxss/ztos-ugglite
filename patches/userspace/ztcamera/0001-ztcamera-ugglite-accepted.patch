+static int lens_fd = -1;
+static struct v4l2_queryctrl lens_range;
+
+static bool lens_property(const char *entry, const char *property, uint32_t *value) {
+	char path[256];
+	snprintf(path, sizeof(path), "/sys/class/video4linux/%.63s/device/of_node/%s",
+		entry, property);
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return false;
+	}
+	ssize_t n = read(fd, value, sizeof(*value));
+	close(fd);
+	return n == sizeof(*value);
+}
+
+static void lens_open(void) {
+	DIR *dir = opendir("/sys/class/video4linux");
+	if (!dir) {
+		return;
+	}
+	struct dirent *entry;
+	uint32_t focus = 0;
+	while ((entry = readdir(dir))) {
+		if (strncmp(entry->d_name, "v4l-subdev", 10) == 0 &&
+		    lens_property(entry->d_name, "lens-focus", &focus) && focus) {
+			break;
+		}
+	}
+	if (entry) {
+		rewinddir(dir);
+		while ((entry = readdir(dir))) {
+			uint32_t phandle;
+			if (strncmp(entry->d_name, "v4l-subdev", 10) != 0 ||
+			    !lens_property(entry->d_name, "phandle", &phandle) ||
+			    phandle != focus) {
+				continue;
+			}
+			char path[80];
+			snprintf(path, sizeof(path), "/dev/%.63s", entry->d_name);
+			int fd = open(path, O_RDWR | O_CLOEXEC);
+			struct v4l2_queryctrl range = { .id = V4L2_CID_FOCUS_ABSOLUTE };
+			if (fd >= 0 && ioctl(fd, VIDIOC_QUERYCTRL, &range) == 0 &&
+			    !(range.flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY)) &&
+			    range.step > 0) {
+				lens_fd = fd;
+				lens_range = range;
+				ui.ctl[1] = 0;
+			} else if (fd >= 0) {
+				close(fd);
+			}
+			break;
+		}
+	}
+	closedir(dir);
+}
+
+/* ---- the sensor's own exposure and gain (the live V4L2 path) -------------- */
+
+/*
+ * The CSI node hands over Bayer while the sensor's exposure, analogue gain and
+ * lens live on their own subdevices. Node numbers are not stable across boots,
+ * so the sensor is found by what it answers: V4L2_CID_EXPOSURE and
+ * V4L2_CID_ANALOGUE_GAIN, both writable. Its sysfs name only breaks a tie,
+ * favouring "s5k", so a CSI receiver or the lens node cannot be mistaken for
+ * it. With no such subdevice the path keeps the old software stretch: a camera
+ * without an exposure control still shows a picture.
+ *
+ * The s5k2xx driver takes exposure in lines (0x0202) and analogue gain as
+ * 0x20..0x200 (0x0204), one frame is 30 fps, so the control's own maximum is
+ * about 1/30 s and 1/500 is where the task's shutter range starts to bite.
+ */
+#define V4L2_AE_PCT		0.45	/* of white above black: mid grey */
+#define V4L2_AE_EVERY		6	/* frames between decisions; the sensor lags two */
+#define V4L2_AE_DEADBAND	0.08	/* +-8 % counts as exposed */
+#define V4L2_AE_STEP		1.5	/* the most one decision may change */
+#define V4L2_AE_STRETCH		1.5	/* software stretch while the sensor is driven */
+#define V4L2_AE_FPS		30.0	/* the exposure maximum is one frame at this rate */
+
+static struct {
+	int fd;				/* the sensor subdev, -1 none */
+	struct v4l2_queryctrl exp, gain;
+	bool ready;
+	int coarse, again;		/* last values written, control units */
+	uint32_t frames, last_ms;
+	int fails;
+} snr = { .fd = -1, .coarse = -1, .again = -1 };
+
+static int clamp_int(int v, int lo, int hi) {
+	return v < lo ? lo : v > hi ? hi : v;
+}
+
+/* VIDIOC_S_CTRL rounds to the control's own grid anyway; writing the value the
+ * log and a later cget will show keeps the two honest. */
+static int sensor_step(const struct v4l2_queryctrl *q, int want) {
+	want = clamp_int(want, q->minimum, q->maximum);
+	if (q->step > 1) {
+		want = q->minimum + (want - q->minimum) / q->step * q->step;
+	}
+	return want;
+}
+
+static void sensor_sysfs_name(const char *entry, char *out, size_t len) {
+	char path[256];
+	out[0] = 0;
+	snprintf(path, sizeof(path), "/sys/class/video4linux/%.63s/name", entry);
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return;
+	}
+	ssize_t n = read(fd, out, len - 1);
+	close(fd);
+	if (n <= 0) {
+		out[0] = 0;
+		return;
+	}
+	out[n] = 0;
+	char *nl = strchr(out, '\n');
+	if (nl) {
+		*nl = 0;
+	}
+}
+
+static bool sensor_query(int fd, uint32_t id, struct v4l2_queryctrl *out) {
+	struct v4l2_queryctrl q;
+	memset(&q, 0, sizeof(q));
+	q.id = id;
+	if (ioctl(fd, VIDIOC_QUERYCTRL, &q) != 0) {
+		return false;
+	}
+	if (q.flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY)) {
+		return false;
+	}
+	if (q.type != V4L2_CTRL_TYPE_INTEGER || q.step <= 0 || q.maximum <= q.minimum) {
+		return false;
+	}
+	*out = q;
+	return true;
+}
+
+static void sensor_close(void) {
+	if (snr.fd >= 0) {
+		close(snr.fd);
+	}
+	snr.fd = -1;
+	snr.ready = false;
+	snr.coarse = snr.again = -1;
+	snr.fails = 0;
+}
+
+static void sensor_open(void) {
+	sensor_close();
+	DIR *dir = opendir("/dev");
+	if (!dir) {
+		return;
+	}
+	struct v4l2_queryctrl best_exp = { 0 }, best_gain = { 0 };
+	char best_name[96] = "";
+	int best = -1, best_score = -1;
+	struct dirent *entry;
+	while ((entry = readdir(dir))) {
+		if (strncmp(entry->d_name, "v4l-subdev", 10) != 0) {
+			continue;
+		}
+		char path[80], name[96];
+		snprintf(path, sizeof(path), "/dev/%.63s", entry->d_name);
+		sensor_sysfs_name(entry->d_name, name, sizeof(name));
+		int fd = open(path, O_RDWR | O_CLOEXEC);
+		if (fd < 0) {
+			continue;
+		}
+		struct v4l2_queryctrl e, g;
+		if (!sensor_query(fd, V4L2_CID_EXPOSURE, &e) ||
+		    !sensor_query(fd, V4L2_CID_ANALOGUE_GAIN, &g)) {
+			close(fd);
+			continue;
+		}
+		int score = strstr(name, "s5k") ? 2 : strstr(name, "sensor") ? 1 : 0;
+		if (score > best_score) {
+			if (best >= 0) {
+				close(best);
+			}
+			best = fd;
+			best_score = score;
+			best_exp = e;
+			best_gain = g;
+			snprintf(best_name, sizeof(best_name), "%s", name);
+		} else {
+			close(fd);
+		}
+	}
+	closedir(dir);
+	if (best < 0) {
+		return;
+	}
+	snr.fd = best;
+	snr.exp = best_exp;
+	snr.gain = best_gain;
+	snr.ready = true;
+	/* start from what the sensor has now, so the first decision is a small one */
+	struct v4l2_control c = { .id = V4L2_CID_EXPOSURE };
+	if (ioctl(best, VIDIOC_G_CTRL, &c) != 0) {
+		c.value = best_exp.default_value > 0 ? best_exp.default_value : best_exp.minimum;
+	}
+	snr.coarse = clamp_int(c.value, best_exp.minimum, best_exp.maximum);
+	c.id = V4L2_CID_ANALOGUE_GAIN;
+	if (ioctl(best, VIDIOC_G_CTRL, &c) != 0) {
+		c.value = best_gain.default_value > 0 ? best_gain.default_value : best_gain.minimum;
+	}
+	snr.again = clamp_int(c.value, best_gain.minimum, best_gain.maximum);
+	fprintf(stderr, "ztcamera: sensor %.48s: exposure %d..%d, analogue gain %d..%d, now %d/%d\n",
+		best_name, best_exp.minimum, best_exp.maximum, best_gain.minimum,
+		best_gain.maximum, snr.coarse, snr.again);
+}
+
+static bool sensor_write(uint32_t id, int value, const char *what) {
+	if (!snr.ready || snr.fd < 0) {
+		return false;
+	}
+	struct v4l2_control c = { .id = id, .value = value };
+	if (ioctl(snr.fd, VIDIOC_S_CTRL, &c) == 0) {
+		snr.fails = 0;
+		return true;
+	}
+	if (++snr.fails >= 3) {
+		fprintf(stderr, "ztcamera: sensor %s write failed (%s); back to software exposure\n",
+			what, strerror(errno));
+		sensor_close();	/* the old path takes over again */
+	}
+	return false;
+}
+
+static bool sensor_set_exposure(int lines) {
+	lines = sensor_step(&snr.exp, lines);
+	if (lines == snr.coarse) {
+		return true;
+	}
+	if (!sensor_write(V4L2_CID_EXPOSURE, lines, "exposure")) {
+		return false;
+	}
+	snr.coarse = lines;
+	return true;
+}
+
+static bool sensor_set_gain(int code) {
+	code = sensor_step(&snr.gain, code);
+	if (code == snr.again) {
+		return true;
+	}
+	if (!sensor_write(V4L2_CID_ANALOGUE_GAIN, code, "analogue gain")) {
+		return false;
+	}
+	snr.again = code;
+	return true;
+}
+
+/* ISO 100..3200 on the dial, 32..512 on the sensor. The dial is in ISO stops,
+ * so the gain is too: the whole control range is spread over the five stops
+ * from 100 to 3200, which puts 100 at 32, 800 near 169 and 3200 at the top. */
+static int iso_to_gain(int index) {
+	static const int iso[] = { 100, 200, 400, 800, 1600, 3200 };
+	if (!snr.ready || index < 1 || index > 6) {
+		return -1;
+	}
+	double top = (double)snr.gain.maximum / snr.gain.minimum;
+	double stops = log2((double)iso[index - 1] / iso[0]);
+	double code = snr.gain.minimum * pow(2.0, stops * log2(top) / 5.0);
+	return sensor_step(&snr.gain, (int)(code + 0.5));
+}
+
+/* The dial's shutter in lines. One frame is V4L2_AE_FPS, and the control's own
+ * maximum is that frame less its margin, so 1/30 is the maximum and the range
+ * asked for, 1/30..1/500, lands at 3242..195 on this sensor. Slower speeds
+ * would need a lower frame rate, which this node does not offer; they clamp. */
+static int shutter_to_lines(int index) {
+	static const double sec[] = { 4, 1, 0.25, 1 / 15.0, 1 / 30.0, 1 / 125.0,
+		1 / 500.0, 1 / 2000.0, 1 / 8000.0 };
+	if (!snr.ready || index < 1 || index > 9) {
+		return -1;
+	}
+	double lines = sec[index - 1] * V4L2_AE_FPS * snr.exp.maximum;
+	return sensor_step(&snr.exp, (int)(lines + 0.5));
+}
+
+static void sensor_manual(int control, int value) {
+	if (!snr.ready) {
+		return;
+	}
+	if (control == 2) {
+		if (value == 0) {
+			note("iso: auto");
+		} else {
+			int gain = iso_to_gain(value);
+			if (gain >= 0 && sensor_set_gain(gain)) {
+				note("iso: %s -> analogue_gain %d [%d..%d]", ctl_opts[2][value],
+					snr.again, snr.gain.minimum, snr.gain.maximum);
+			} else {
+				note("iso: sensor write failed");
+			}
+		}
+	} else {
+		if (value == 0) {
+			note("shutter: auto");
+		} else {
+			int lines = shutter_to_lines(value);
+			bool slow = value <= 4;	/* 4 s .. 1/15: past one 30 fps frame */
+			if (lines >= 0 && sensor_set_exposure(lines)) {
+				note("shutter: %s -> exposure %d lines%s [%d..%d]", ctl_opts[3][value],
+					snr.coarse, slow ? " (clamped: one frame is 1/30 s)" : "",
+					snr.exp.minimum, snr.exp.maximum);
+			} else {
+				note("shutter: sensor write failed");
+			}
+		}
+	}
+	snr.frames = 0;
+	snr.last_ms = 0;	/* the next frame decides afresh */
+}
+
+/* Green mean of the Bayer frame, black subtracted; clipped sites are counted
+ * apart so a blown highlight does not pull the decision down on its own. */
+static int sensor_green_mean(const uint16_t *b, int w, int h, int *clip) {
+	long long sum = 0, n = 0, seen = 0, hot = 0;
+	for (int y = 0; y + 1 < h; y += 16) {
+		const uint16_t *row = b + (size_t)y * w;
+		for (int x = 0; x + 1 < w; x += 16) {
+			int v = row[x];	/* (0,0) is green in the GRBG cell */
+			seen++;
+			if (v >= RAW_WHITE - 32) {
+				hot++;
+				continue;
+			}
+			sum += v - RAW_BLACK;
+			n++;
+		}
+	}
+	*clip = seen ? (int)(hot * 100 / seen) : 0;
+	return n ? (int)(sum / n) + RAW_BLACK : 0;
+}
+
+/*
+ * AE in the sensor's own terms: exposure first, gain only once the exposure
+ * control is against one of its ends, which is also the low-noise order. One
+ * auto control is enough: a manual ISO leaves the shutter auto and the other
+ * way round. Both manual means the dials own the sensor and this does nothing.
+ */
+static void sensor_ae(const uint16_t *b, int w, int h) {
+	if (!snr.ready || (ui.ctl[2] != 0 && ui.ctl[3] != 0)) {
+		return;
+	}
+	if (sweep.active) {
+		return;		/* one exposure for the whole focus sweep: comparable scores */
+	}
+	if (++snr.frames < V4L2_AE_EVERY) {
+		return;
+	}
+	snr.frames = 0;
+	uint32_t now = zmc_now_ms();
+	if (snr.last_ms && now - snr.last_ms < 120) {
+		return;
+	}
+	snr.last_ms = now;
+
+	int clip;
+	int green = sensor_green_mean(b, w, h, &clip);
+	double target = RAW_BLACK + V4L2_AE_PCT * (RAW_WHITE - RAW_BLACK);
+	if (clip > 5) {
+		target *= 0.75;		/* hold the highlights */
+	}
+	if (green < RAW_BLACK + 4) {
+		green = RAW_BLACK + 4;
+	}
+	double r = target / green;
+	if (fabs(r - 1) < V4L2_AE_DEADBAND) {
+		return;			/* deadband: neither control clicks back and forth */
+	}
+	r = fmin(V4L2_AE_STEP, fmax(1 / V4L2_AE_STEP, r));
+
+	int lines = snr.coarse > 0 ? snr.coarse : snr.exp.minimum;
+	int gain = snr.again > 0 ? snr.again : snr.gain.minimum;
+	bool iso_manual = ui.ctl[2] != 0, shutter_manual = ui.ctl[3] != 0;
+	double total = (double)lines * gain * r;
+	int want_lines = lines, want_gain = gain;
+	if (!shutter_manual) {
+		want_lines = sensor_step(&snr.exp, (int)(lines * r + 0.5));
+	}
+	if (!iso_manual) {
+		want_gain = sensor_step(&snr.gain, (int)(total / (want_lines > 0 ? want_lines : 1) + 0.5));
+	}
+	if (want_lines == lines && want_gain == gain) {
+		return;
+	}
+	bool moved = false;
+	if (want_lines != lines && sensor_set_exposure(want_lines)) {
+		moved = true;
+	}
+	if (want_gain != gain && sensor_set_gain(want_gain)) {
+		moved = true;
+	}
+	if (moved) {
+		fprintf(stderr, "ztcamera: ae green %d target %.0f%s -> exposure %d gain %d\n",
+			green, target, clip > 5 ? " clipped" : "", snr.coarse, snr.again);
+	}
+}
+
+static const char *control_label(int control, int value) {
+	if (control == 1 && lens_fd >= 0) {
+		static const char *const labels[] = { "default", "high", "middle", "low" };
+		return labels[value];
+	}
+	return ctl_opts[control][value];
+}
+
+/* The four values the focus dial offers, on the control's own step grid. */
+static int lens_preset(int index) {
+	int steps = lens_range.step > 0 ?
+		(lens_range.maximum - lens_range.minimum) / lens_range.step : 0;
+	if (index == 1) {
+		return lens_range.maximum;
+	}
+	if (index == 2) {
+		return lens_range.minimum + (steps / 2) * lens_range.step;
+	}
+	if (index == 3) {
+		return lens_range.minimum;
+	}
+	return lens_range.default_value;
+}
+
+/* One write to V4L2_CID_FOCUS_ABSOLUTE. The dial and the sweep both go through
+ * here, so neither can drift from the control's own range and step. */
+static bool lens_set_value(int value) {
+	if (lens_fd < 0) {
+		return false;
+	}
+	struct v4l2_control focus = { .id = V4L2_CID_FOCUS_ABSOLUTE, .value = value };
+	return ioctl(lens_fd, VIDIOC_S_CTRL, &focus) == 0;
+}
+
+static bool control_set(int control, int value) {
+	if (control == 1 && lens_fd >= 0) {
+		if (!lens_set_value(lens_preset(value))) {
+			note("focus: %s", strerror(errno));
+			return false;
+		}
+		/* a hand on the dial wins over the sweep, always */
+		sweep.active = false;
+		if (value == 0) {
+			/* the dial's "default" is its auto: let the AF have the lens back */
+			afc.manual = false;
+			afc.held = 0;
+			afc.primed = false;
+			afc.next = zmc_now_ms() + 400;
+		} else {
+			afc.manual = true;
+		}
+	}
+	ui.ctl[control] = value;
+	if ((control == 2 || control == 3) && src.kind == SRC_V4L2 && snr.ready) {
+		sensor_manual(control, value);	/* its note() says what was written */
+	}
+	return true;
+}
+
+/* ---- the contrast sweep ---------------------------------------------------- */
+
+/* The last frame's green mean, in raw counts, shared by the sweep and the AF
+ * monitor: a black frame's noise scores as sharp at any lens position, and a
+ * blown one has no detail left to score. */
+static int bayer_mean = RAW_BLACK;
+
+static int lens_steps(void) {
+	return lens_range.step > 0 ?
+		(lens_range.maximum - lens_range.minimum) / lens_range.step : 0;
+}
+
+static int lens_at_step(int step) {
+	int value = lens_range.minimum + step * lens_range.step;
+	return value > lens_range.maximum ? lens_range.maximum : value;
+}
+
+/* The two passes on the control's own step grid. The coarse pass is the whole
+ * range; the fine pass is half a coarse interval either side of the sharpest
+ * coarse position, which always brackets the peak (the coarse best is at most
+ * half an interval from it) and is about four times finer than a coarse move. */
+static void focus_sweep_positions(bool fine) {
+	int span = lens_steps();
+	int count = fine ? FOCUS_FINE_STEPS : FOCUS_COARSE_STEPS;
+	int lo = 0, hi = span;
+	if (fine) {
+		int cstep = span / (FOCUS_COARSE_STEPS - 1);
+		int half = (int)(cstep * FOCUS_FINE_SPAN + 0.5);
+		if (half < 1) {
+			half = 1;
+		}
+		lo = sweep.coarse_best - half;
+		hi = sweep.coarse_best + half;
+		if (lo < 0) {
+			lo = 0;
+		}
+		if (hi > span) {
+			hi = span;
+		}
+		if (hi - lo < 2) {
+			lo = sweep.coarse_best > 0 ? sweep.coarse_best - 1 : 0;
+			hi = sweep.coarse_best < span ? sweep.coarse_best + 1 : span;
+		}
+	}
+	sweep.npos = 0;
+	for (int i = 0; i < count; i++) {
+		int step = lo + (int)(((long)(hi - lo) * i + (count - 1) / 2) / (count - 1));
+		if (sweep.npos == 0 || step != sweep.pos[sweep.npos - 1]) {
+			sweep.pos[sweep.npos++] = step;
+		}
+	}
+}
+
+static int luma_of(uint32_t p) {
+	return (int)((((p >> 16) & 0xff) * 77 + ((p >> 8) & 0xff) * 151 +
+		(p & 0xff) * 28) >> 8);
+}
+
+/* Tenengrad sharpness of the middle 60 % of the picture: the sum of squared
+ * Sobel gradients. Squaring weights real edges over the sensor's noise floor,
+ * which the old mean absolute step did not; dividing by the squared mean luma
+ * makes the score comparable when the AE changes the exposure between the
+ * sweep and the monitor. Frames with no trustworthy detail are rejected only
+ * when they are truly unusable: a raw green mean at the black floor, a nearly
+ * black ROI, or a clipped ROI all return -2. The old black+30 gate is gone:
+ * the AF raises exposure and gain before scoring a dark scene (af_boost), and
+ * black+10 is the honest floor below which the remaining samples are noise. */
+static double focus_region_score(double *mean_out, double *norm_out) {
+	if (src.kind != SRC_V4L2 || !src.bayer || !src.frame ||
+	    cairo_surface_status(src.frame) != CAIRO_STATUS_SUCCESS) {
+		return -1;
+	}
+	int w = cairo_image_surface_get_width(src.frame);
+	int h = cairo_image_surface_get_height(src.frame);
+	int rw = (int)(w * FOCUS_REGION) & ~1, rh = (int)(h * FOCUS_REGION) & ~1;
+	const uint8_t *data = cairo_image_surface_get_data(src.frame);
+	if (rw < 16 || rh < 16 || !data) {
+		return -1;
+	}
+	if (bayer_mean < RAW_BLACK + 10 || bayer_mean > RAW_WHITE - 16) {
+		return -2;	/* below the noise floor / fully blown: nothing to score */
+	}
+	int stride = cairo_image_surface_get_stride(src.frame);
+	int x0 = (w - rw) / 2, y0 = (h - rh) / 2;
+	double sum_g2 = 0, sum_l = 0;
+	long n = 0, blown = 0;
+	for (int y = y0; y < y0 + rh; y++) {
+		const uint32_t *up = (const uint32_t *)(data + (size_t)(y - 1) * stride);
+		const uint32_t *mid = (const uint32_t *)(data + (size_t)y * stride);
+		const uint32_t *down = (const uint32_t *)(data + (size_t)(y + 1) * stride);
+		for (int x = x0; x < x0 + rw; x++) {
+			int l00 = luma_of(up[x - 1]), l01 = luma_of(up[x]), l02 = luma_of(up[x + 1]);
+			int l10 = luma_of(mid[x - 1]), l11 = luma_of(mid[x]), l12 = luma_of(mid[x + 1]);
+			int l20 = luma_of(down[x - 1]), l21 = luma_of(down[x]), l22 = luma_of(down[x + 1]);
+			int gx = (l02 + 2 * l12 + l22) - (l00 + 2 * l10 + l20);
+			int gy = (l20 + 2 * l21 + l22) - (l00 + 2 * l01 + l02);
+			sum_g2 += (double)gx * gx + (double)gy * gy;
+			sum_l += l11;
+			if (l11 >= 250) {
+				blown++;
+			}
+			n++;
+		}
+	}
+	if (n < 256) {
+		return -1;
+	}
+	double mean = sum_l / (double)n;
+	if (mean < 3 || blown * 100 > n * 15) {
+		return -2;	/* the ROI itself is black or mostly clipped */
+	}
+	double ten = sum_g2 / (double)n;
+	if (mean_out) {
+		*mean_out = mean;
+	}
+	if (norm_out) {
+		*norm_out = ten / ((mean + 1) * (mean + 1));
+	}
+	return ten;
+}
+
+/* ---- scene change: AF-S when the subject, not the focus, changes ---------- */
+
+/* Fed from bayer_frame() with a 16-bin histogram of the same sampled green
+ * sites, normalised by that frame's mean luma so a global AE step does not look
+ * like a new subject. A scene change moves this shape in one frame; two
+ * consecutive detections (45 ms at 30 fps) confirm it and the next tick runs
+ * AF-S. A large mean jump must also move the shape, so a lamp or the AE is not
+ * mistaken for a new plan. Between events the reference adapts slowly. */
+static void scene_observe(const uint16_t *nhist, unsigned n, int mean) {
+	if (n == 0) {
+		return;
+	}
+	if (sweep.active) {
+		return;		/* the lens is moving: not evidence about the scene */
+	}
+	uint32_t now = zmc_now_ms();
+	if (!scene.have) {
+		scene.have = true;
+		scene.mean = mean;
+		memcpy(scene.nhist, nhist, sizeof(scene.nhist));
+		scene.cand_since = 0;
+		return;
+	}
+	double dist = 0;
+	for (int i = 0; i < AF_SCENE_BINS; i++) {
+		dist += fabs((double)nhist[i] - scene.nhist[i]);
+	}
+	dist /= 2.0 * n;
+	double mean_jump = fabs((double)mean - scene.mean);
+	bool jump = dist > AF_SCENE_HIST_DIST ||
+		(mean_jump > AF_SCENE_MEAN_FRAC * (RAW_WHITE - RAW_BLACK) &&
+		 dist > AF_SCENE_HIST_DIST / 3.0);
+	if (jump) {
+		if (!scene.cand_since) {
+			scene.cand_since = now;
+		} else if (now - scene.cand_since >= AF_SCENE_CONFIRM_MS &&
+			   now - scene.last_fire >= AF_SCENE_MIN_GAP_MS) {
+			/* confirmed: one AF-S, then a fresh reference */
+			scene.last_fire = now;
+			scene.cand_since = 0;
+			scene.have = false;
+			afc.scene = true;
+		}
+	} else {
+		scene.cand_since = 0;
+		scene.mean += ((double)mean - scene.mean) * 0.2;
+		for (int i = 0; i < AF_SCENE_BINS; i++) {
+			scene.nhist[i] = (uint16_t)((scene.nhist[i] * 4u + nhist[i] + 2u) / 5u);
+		}
+	}
+}
+
+/* A dark scene is exposed for the sweep instead of being refused. Exposure is
+ * raised first (longer integration is the low-noise way), then analogue gain,
+ * for a total of about 6x, bounded by the sensor's own control maxima. The
+ * previous values go back when the sweep ends and the AE takes over again; the
+ * one exposure for all positions keeps the scores comparable. If both ISO and
+ * shutter are manual the user owns the exposure and is not overridden. */
+static void af_boost_restore(void) {
+	if (!af_boost.active) {
+		return;
+	}
+	af_boost.active = false;
+	int exp = af_boost.exp, gain = af_boost.gain;
+	af_boost.exp = af_boost.gain = 0;
+	if (snr.ready) {
+		sensor_set_exposure(exp);
+		sensor_set_gain(gain);
+	}
+}
+
+static void af_boost_start(void) {
+	if (!snr.ready || af_boost.active || bayer_mean >= RAW_BLACK + 24) {
+		return;
+	}
+	if (ui.ctl[2] != 0 && ui.ctl[3] != 0) {
+		return;		/* both manual: the dials own the exposure */
+	}
+	int old_exp = snr.coarse, old_gain = snr.again;
+	if (old_exp <= 0 || old_gain <= 0) {
+		return;
+	}
+	af_boost.active = true;
+	af_boost.exp = old_exp;
+	af_boost.gain = old_gain;
+	if (ui.ctl[3] == 0) {
+		sensor_set_exposure(sensor_step(&snr.exp, old_exp * 2));
+	}
+	if (ui.ctl[2] == 0) {
+		double used = (double)snr.coarse / old_exp;
+		double want = used > 0 ? 6.0 / used : 6.0;
+		sensor_set_gain(sensor_step(&snr.gain, (int)(old_gain * want + 0.5)));
+	}
+	fprintf(stderr, "ztcamera: af dark boost: exposure %d->%d gain %d->%d\n",
+		old_exp, snr.coarse, old_gain, snr.again);
+}
+
+static void focus_sweep_cancel(const char *why) {
+	if (!sweep.active) {
+		return;
+	}
+	bool was_auto = sweep.automatic;
+	sweep.active = false;
+	if (why && strstr(why, "dark")) {
+		afc.dark_fail_until = zmc_now_ms() + AF_DARK_RETRY_MS;
+	}
+	af_boost_restore();
+	afc.scene = false;
+	scene.have = false;	/* the scene reference is new after the lens moved */
+	if (why && !was_auto) {
+		note("%s", why);
+	}
+	if (was_auto) {
+		/* a failed opening sweep must not become the monitor's baseline:
+		 * retry a little later instead of living with a soft picture */
+		afc.primed = false;
+		afc.next = zmc_now_ms() + 3000;
+	}
+	chrome_redraw_mark();
+}
+
+/* false when the lens, a menu, the recorder or the exposure mean "not now". */
+static bool focus_sweep_start(bool automatic) {
+	if (lens_fd < 0 || src.kind != SRC_V4L2 || !src.bayer) {
+		return false;	/* no lens on this source, nothing to sweep */
+	}
+	if (ui.recording) {
+		if (!automatic) {
+			note("focus: off while recording");
+		}
+		return false;	/* the focus a clip starts with is the focus it keeps */
+	}
+	if (ui.menu || ui.reviewing || ui.about || ui.dial >= 0) {
+		if (!automatic) {
+			note("focus: close the dial first");
+		}
+		return false;
+	}
+	if (bayer_mean > RAW_WHITE - 16) {
+		if (!automatic) {
+			note("focus: frame is clipped");
+		}
+		return false;	/* a blown frame has no detail to score */
+	}
+	af_boost_start();	/* a dark frame is exposed for the sweep, not refused */
+	sweep.active = false;	/* a second tap starts over */
+	sweep.automatic = automatic;
+	sweep.stage = 0;
+	sweep.idx = 0;
+	sweep.bad = 0;
+	sweep.coarse_best = 0;
+	sweep.coarse_best_score = 0;
+	focus_sweep_positions(false);
+	if (!lens_set_value(lens_at_step(sweep.pos[0]))) {
+		af_boost_restore();
+		note("focus: %s", strerror(errno));
+		return false;
+	}
+	uint32_t now = zmc_now_ms();
+	sweep.active = true;
+	sweep.started = now;
+	sweep.deadline = now + (af_boost.active ? AF_BOOST_SETTLE_MS : FOCUS_SETTLE_MS);
+	ui.focusing = false;
+	ui.focused = false;
+	if (!automatic) {
+		note("focus: sweeping");
+		zmc_haptic("tick");	/* an automatic sweep must not buzz at the user */
+	}
+	chrome_redraw_mark();
+	return true;
+}
+
+/* Back to the sharpest position, and stop there: the lens is not hunting. The
+ * final value is the vertex of the parabola through the best fine sample and
+ * its two neighbours, so the lens lands between measurement steps. */
+static void focus_sweep_finish(void) {
+	int n = sweep.npos;
+	if (n <= 0) {
+		focus_sweep_cancel("focus: nothing to score");
+		return;
+	}
+	int fb = 0;
+	for (int i = 1; i < n; i++) {
+		if (sweep.ten[i] > sweep.ten[fb]) {
+			fb = i;
+		}
+	}
+	/* The coarse best is one of the fine positions. Re-measuring the same
+	 * lens position moves the score by a few percent of noise; that must not
+	 * move the lens off the position the coarse pass selected. */
+	int cb = -1;
+	for (int i = 0; i < n; i++) {
+		if (sweep.pos[i] == sweep.coarse_best) {
+			cb = i;
+		}
+	}
+	if (cb >= 0 && sweep.ten[cb] * 1.02 > sweep.ten[fb]) {
+		fb = cb;
+	}
+	int step = sweep.pos[fb];
+	double score = sweep.ten[fb], norm = sweep.norm[fb];
+	if (fb > 0 && fb + 1 < n && sweep.pos[fb + 1] > sweep.pos[fb]) {
+		double a = sweep.ten[fb - 1], b = sweep.ten[fb], c = sweep.ten[fb + 1];
+		double den = a - 2 * b + c;
+		if (den < 0) {
+			double off = 0.5 * (a - c) / den;
+			if (off > 0.75) {
+				off = 0.75;
+			} else if (off < -0.75) {
+				off = -0.75;
+			}
+			step = (int)(sweep.pos[fb] + off * (sweep.pos[fb + 1] - sweep.pos[fb]) + 0.5);
