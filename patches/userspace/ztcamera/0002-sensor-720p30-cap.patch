--- a/camera/ztcamera.c
+++ b/camera/ztcamera.c
@@ -556,6 +556,49 @@
 	fprintf(stderr, "ztcamera: sensor %.48s: exposure %d..%d, analogue gain %d..%d, now %d/%d\n",
 		best_name, best_exp.minimum, best_exp.maximum, best_gain.minimum,
 		best_gain.maximum, snr.coarse, snr.again);
+	/* Match the sensor's frame time to the rate the recorder writes, instead of
+	 * leaving the 1280x720 mode at its table default. That mode's register set
+	 * has VTS 812 lines = 120 fps at the 562.5 MHz pixel clock (5808 x 812 x
+	 * 119.3 was read off the live stream's timestamps), which (a) burns 4x the
+	 * CSI/VFE/DMA and interrupt budget this app can consume, (b) gives the
+	 * exposure control a 1/120 s frame, so 804 lines is its maximum and the AE
+	 * clamps there although the shutter dial is scaled for 1/30 s (V4L2_AE_FPS),
+	 * which is why dark scenes stay dark. One frame must be REC_PERIOD_MS.
+	 * VTS 3250 is the sensor's own 30 fps timing (the 4208x3120 mode uses the
+	 * same value, 29.8 fps here); 24 fps needs 4036, 15 fps 6458. VBLANK is a
+	 * writable control: s5k2xx_set_ctrl() writes FLL = height + vblank and
+	 * widens the exposure range to height + vblank - 8 in the same call. This
+	 * runs after STREAMON, so the sensor is powered and the write lands. */
+	if (strstr(best_name, "s5k3l8")) {
+		const int height = 720;		/* the 1280x720 mode */
+		int want = (int)(REC_FPS + 0.5), vts;
+		struct v4l2_queryctrl vq;
+		struct v4l2_control vb = { .id = V4L2_CID_VBLANK };
+		memset(&vq, 0, sizeof(vq));
+		vq.id = V4L2_CID_VBLANK;
+		if (want < 5) {
+			want = 5;
+		}
+		vts = want >= 30 ? 3250 : (int)(562500000.0 / (5808.0 * want) + 0.5);
+		/* only the 720p mode's VBLANK range ends at FLL_MAX - 720 */
+		if (ioctl(best, VIDIOC_QUERYCTRL, &vq) == 0 &&
+		    vq.maximum == (int)(0xffff - height) &&
+		    ioctl(best, VIDIOC_G_CTRL, &vb) == 0 &&
+		    vb.value != vts - height) {
+			struct v4l2_control set = { .id = V4L2_CID_VBLANK, .value = vts - height };
+			if (ioctl(best, VIDIOC_S_CTRL, &set) == 0) {
+				struct v4l2_queryctrl wide;
+				/* the driver rewrites the exposure range for the new VTS */
+				if (sensor_query(best, V4L2_CID_EXPOSURE, &wide)) {
+					snr.exp = wide;
+					snr.coarse = clamp_int(snr.coarse, snr.exp.minimum, snr.exp.maximum);
+				}
+				fprintf(stderr, "ztcamera: sensor timing: vblank %d -> %d, VTS %d lines (%.1f fps), exposure max %d\n",
+					vb.value, set.value, vts,
+					562500000.0 / (5808.0 * vts), snr.exp.maximum);
+			}
+		}
+	}
 }
 
 static bool sensor_write(uint32_t id, int value, const char *what) {
