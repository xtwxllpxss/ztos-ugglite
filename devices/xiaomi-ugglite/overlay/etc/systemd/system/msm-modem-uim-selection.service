[Unit]
Description=MSM Modem UIM Slot Selection
Before=ModemManager.service
After=ztos-modem.service
Requires=ztos-modem.service

[Service]
Type=notify
ExecStart=/usr/local/libexec/msm-modem-uim-selection
ExecStartPost=/usr/bin/qmicli --silent -pd qrtr://0 --dms-set-operating-mode=online

[Install]
WantedBy=multi-user.target
RequiredBy=ModemManager.service
