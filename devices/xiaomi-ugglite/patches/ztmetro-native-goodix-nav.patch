 /* ---- keyboard (the phone's hardware keys, or a real one) ------------------ */
+
+/* The phone's own touch keys are one evdev device: the Goodix touchscreen,
+ * which the driver also gives generic F1..F6 and LEFT META. Only that device
+ * is read as navigation; a real keyboard's F1, F2 or Super keep their meaning,
+ * and nothing else on the phone is translated. */
+static bool nav_key_source(const char *name) {
+	return name && strcmp(name, "Goodix Capacitive TouchScreen") == 0;
+}
 
+/* Its three keys are, from the left, recents, Start and back. The driver's
+ * own codes are generic placeholders (research/ugglite-touchkeys-capture.md),
+ * so they are translated to the codes ztmetro already reads as nav. */
+static uint32_t nav_key_code(bool nav_keys, uint32_t keycode) {
+	if (!nav_keys) {
+		return keycode;
+	}
+	switch (keycode) {
+	case KEY_LEFTMETA:
+		return KEY_APPSELECT;
+	case KEY_F1:
+		return KEY_HOMEPAGE;
+	case KEY_F2:
+		return KEY_BACK;
+	}
+	return keycode;
+}
+
 static void keyboard_handle_modifiers(struct wl_listener *listener, void *data) {
 	struct zt_keyboard *keyboard = wl_container_of(listener, keyboard, modifiers);
-	wlr_seat_set_keyboard(keyboard->server->seat, keyboard->wlr_keyboard);
-	wlr_seat_keyboard_notify_modifiers(keyboard->server->seat,
-		&keyboard->wlr_keyboard->modifiers);
+	struct wlr_keyboard *wlr_keyboard = keyboard->wlr_keyboard;
+	struct wlr_keyboard_modifiers mods = wlr_keyboard->modifiers;
+	if (keyboard->nav_keys) {
+		/* The left touch key is LEFT META by the driver's generic table and
+		 * is consumed above as recents, so Super is not a meaning it has
+		 * here: the seat and the apps must not see it, or a Super binding
+		 * or a launcher answers a nav press. Cleared in the keyboard's own
+		 * state as well, which is what a focus change sends. */
+		mods.depressed &= ~WLR_MODIFIER_LOGO;
+		wlr_keyboard->modifiers.depressed &= ~WLR_MODIFIER_LOGO;
+	}
+	wlr_seat_set_keyboard(keyboard->server->seat, wlr_keyboard);
+	wlr_seat_keyboard_notify_modifiers(keyboard->server->seat, &mods);
 }
 
