+/* Nothing guarantees ~/.config/ztmetro exists before the first save: create
+   it, otherwise fopen() fails with ENOENT and every save is dropped silently. */
+static void config_dir_make(void) {
+	const char *home = getenv("HOME") ?: "";
+	char dir[512];
+	snprintf(dir, sizeof(dir), "%s/.config", home);
+	if (mkdir(dir, 0700) != 0 && errno != EEXIST) return;
+	snprintf(dir, sizeof(dir), "%s/.config/ztmetro", home);
+	if (mkdir(dir, 0700) != 0 && errno != EEXIST) return;
+}
