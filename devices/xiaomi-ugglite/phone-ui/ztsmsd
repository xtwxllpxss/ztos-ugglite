#!/bin/bash
# ztsmsd (ugglite): ModemManager SMS -> ztMETRO notification + Messages log.
#
# MM is the source of truth:
#   mmcli -m N --messaging-list-sms   "/org/.../SMS/12 (received)"
#   mmcli -m N -s 12 -K               number/text properties
# The text is read through MM's Sms properties (the same values the D-Bus
# org.freedesktop.ModemManager1.Sms Text/Number properties expose); no AT
# commands and no data-control FIFO.
#
# Received messages are appended to /var/lib/ztoscorenetworking/sms/log in the
# TSV format comm.h's messages_load() already reads, so the existing
# ztmessages list shows them without a rebuild.  Each new message also gets a
# ztMETRO banner ("notify") on the shell's control pipe; if that pipe is not
# there, notify-send is tried instead.  An RSCHS/112/emergency message is
# prefixed as urgent, wakes the screen and plays the ringtone once.
set -u

CONF=/etc/ztsmsd.conf
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

if [ -z "${MM_MODEM:-}" ] || [ "$MM_MODEM" = auto ]; then
	MM_MODEM=$(mmcli -L 2>/dev/null | sed -n "s#.*/Modem/\([0-9][0-9]*\).*#\1#p" | head -1)
fi
: "${MM_MODEM:=0}"
: "${STATE_DIR:=/var/lib/ztsmsd}"
: "${SMS_LOG:=/var/lib/ztoscorenetworking/sms/log}"
: "${SLEEP:=2}"
: "${RING_USER:=alarm}"
: "${ALERT_TONE:=/usr/local/share/sounds/ztos/phone/Nokia-Tune.wav}"

RUN_DIR=$STATE_DIR
SEEN="$RUN_DIR/seen"
mkdir -p "$RUN_DIR" "$(dirname "$SMS_LOG")" 2>/dev/null
chmod 755 "$RUN_DIR" 2>/dev/null
touch "$SMS_LOG" 2>/dev/null; chmod 644 "$SMS_LOG" 2>/dev/null

RING_UID=$(id -u "$RING_USER" 2>/dev/null || echo 1000)
: "${RING_RUNTIME:=/run/user/$RING_UID}"

log() {
	printf '%s ztsmsd: %s\n' "$(date '+%H:%M:%S')" "$*"
}

shell_tell() {
	ctl="$RING_RUNTIME/ztmetro.ctl"
	[ -p "$ctl" ] || return 1
	timeout 1 sh -c 'printf "%s\n" "$1" > "$2"' _ "$1" "$ctl" 2>/dev/null
}

notify() {	# number, text, urgent
	number=$1
	text=$2
	urgent=$3
	title="SMS from $number"
	[ "$urgent" = 1 ] && title="ЭКСТРЕННОЕ SMS: $number"
	body=$text
	[ "$urgent" = 1 ] && body="⚠ $text"
	# The shell's own banner.  "notify" alerts (banner + its chime).
	shell_tell "notify ztmessages|$title|$body" && return 0
	# No shell (or an old one): the standard service, if it is running.
	if command -v notify-send >/dev/null 2>&1; then
		runuser -u "$RING_USER" -- env XDG_RUNTIME_DIR="$RING_RUNTIME" \
			DBUS_SESSION_BUS_ADDRESS="unix:path=$RING_RUNTIME/bus" \
			notify-send -a Messages -i ztmessages "$title" "$body" 2>/dev/null && return 0
	fi
	return 1
}

alert_sound() {
	[ -r "$ALERT_TONE" ] || return 0
	runuser -u "$RING_USER" -- env XDG_RUNTIME_DIR="$RING_RUNTIME" \
		pw-play "$ALERT_TONE" >/dev/null 2>&1 &
}

is_emergency() {
	printf '%s %s' "$1" "$2" |
		grep -Eiq 'РСЧС|рсчс|RSCHS|МЧС|мчс|MCHS|экстрен|emergency' && return 0
	printf '%s' "$1" | grep -Eq '^\+?112$' && return 0
	return 1
}

sanitize() {
	printf '%s' "$1" | tr '\t\r\n|' '    ' | cut -c1-480
}

decode_escapes() {	# mmcli -K writes non-ASCII bytes as \NNN octal
	local s=$1 out= c
	while [ -n "$s" ]; do
		case $s in
		\\[0-7][0-7][0-7]*) printf -v c "\\${s:1:3}"; out+=$c; s=${s:4} ;;
		\\\\*) out+='\'; s=${s:2} ;;
		*) out+=${s:0:1}; s=${s:1} ;;
		esac
	done
	printf '%s' "$out"
}

# mmcli 1.24 -K prints "sms.content.text   : value" (key, spaces, colon);
# other builds print "key=value".  The section prefix differs between versions
# (sms.content.* vs sms.properties.*), so match on the last component only.
property() {	# info, name
	printf '%s\n' "$1" | sed -n \
		"s/^[A-Za-z0-9._-]*\.$2[[:space:]]*:[[:space:]]*//p;s/^[A-Za-z0-9._-]*\.$2=//p" |
		head -1
}

while :; do
	list=$(mmcli -m "$MM_MODEM" --messaging-list-sms 2>/dev/null)
	if [ -z "$list" ]; then
		sleep "$SLEEP"
		continue
	fi
	for path in $(printf '%s\n' "$list" | sed -n 's#.*\(/org/freedesktop/ModemManager1/SMS/[0-9][0-9]*\).*#\1#p'); do
		idx=${path##*/}
		key="$path"
		if grep -Fqx "$key" "$SEEN" 2>/dev/null; then
			continue
		fi
		# Only a complete "received" SMS has number/text; MM also lists
		# "receiving" placeholders whose text is still "--".  Match the path
		# with its trailing " (" so SMS/1 does not match SMS/10.
		line=$(printf '%s\n' "$list" | grep -F "$path (" | head -1)
		case "$line" in
		*"(received)"*) ;;
		*) continue ;;
		esac
		info=$(mmcli -m "$MM_MODEM" -s "$idx" -K 2>/dev/null)
		if [ -z "$info" ]; then
			# Fetch failed: do not mark it seen, retry on the next poll.
			continue
		fi
		number=$(decode_escapes "$(property "$info" number)")
		text=$(decode_escapes "$(property "$info" text)")
		if [ -z "$text" ]; then
			# human output fallback: "|      text: ..."
			human=$(mmcli -m "$MM_MODEM" -s "$idx" 2>/dev/null)
			[ -n "$number" ] || number=$(printf '%s\n' "$human" | sed -n 's/.*| *number: //p' | head -1)
			text=$(printf '%s\n' "$human" | sed -n 's/.*| *text: //p' | head -1)
		fi
		text=$(sanitize "${text:-}")
		if [ -z "$number" ] && [ -z "$text" ]; then
			continue	# unreadable PDU, keep retrying
		fi
		[ -n "$number" ] || number="unknown"

		# MM renumbers /SMS/N after a ModemManager restart; the SMS service
		# timestamp does not change, so it is the stable dedupe key.
		ts=$(decode_escapes "$(property "$info" timestamp)")
		if [ -n "$ts" ] && grep -Fqx "$ts|$number|$text" "$SEEN" 2>/dev/null; then
			printf '%s\n' "$key" >> "$SEEN"
			continue
		fi
		printf '%s\n' "$key" >> "$SEEN"
		[ -n "$ts" ] && printf '%s\n' "$ts|$number|$text" >> "$SEEN"

		printf 'in\t%s\t%s\t%s\n' "$(date +%s)" "$number" "$text" >> "$SMS_LOG"
		log "SMS $idx from $number: $text"

		if is_emergency "$number" "$text"; then
			shell_tell "screen on"
			notify "$number" "$text" 1
			alert_sound
			log "EMERGENCY SMS from $number"
		else
			notify "$number" "$text" 0
		fi
	done
	sleep "$SLEEP"
done
