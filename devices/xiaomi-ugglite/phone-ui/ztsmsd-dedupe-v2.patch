+sms_timestamp_epoch() {	# ISO8601 from MM -> epoch, empty if unknown
+	[ -n "$1" ] || return 1
+	case $1 in -*|--*) return 1 ;; esac
+	date -d "$1" +%s 2>/dev/null
+}
+
+# ---------------------------------------------------------------------------
+# Stuck `(receiving)` watchdog.  MM exports incomplete multipart SMS objects
+# on purpose (mm-base-sms.c:1878) and never times them out, so one can sit in
+# `receiving` for days (SMS/1 since 2026-11-05).  We only REPORT it: deleting
+# the object is the user's decision, and deleting the wrong thing could remove
+# a real stored message.
+#   $RECEIVING lines: <path>\t<first_seen_epoch>\t<storage>\t<scts>\t<number>
+#   $WARNED lines:    <path>
+# ---------------------------------------------------------------------------
+report_stuck_receiving() {
+	local list=$1 now live p first storage scts number idx info tmp changed old
+	now=$(date +%s)
+	live=$(printf '%s\n' "$list" |
+		sed -n 's#.*\(/org/freedesktop/ModemManager1/SMS/[0-9][0-9]*\) (receiving).*#\1#p')
+
+	# Nothing receiving and no bookkeeping left: common case, do nothing.
+	if [ -z "$live" ] && [ ! -s "$RECEIVING" ] && [ ! -s "$WARNED" ]; then
+		return 0
+	fi
+	: >> "$RECEIVING" 2>/dev/null
+	: >> "$WARNED" 2>/dev/null
+
+	# Drop objects that are no longer `receiving`.
+	if [ -s "$RECEIVING" ]; then
+		tmp=$(mktemp "${TMPDIR:-/tmp}/ztsmsd.XXXXXX") || return 0
+		while IFS="$(printf '\t')" read -r p first storage scts number; do
+			[ -n "$p" ] || continue
+			printf '%s\n' "$live" | grep -Fqx "$p" && \
+				printf '%s\t%s\t%s\t%s\t%s\n' "$p" "$first" "$storage" "$scts" "$number"
+		done < "$RECEIVING" > "$tmp"
+		if cmp -s "$tmp" "$RECEIVING"; then rm -f "$tmp"; else mv "$tmp" "$RECEIVING"; fi
+	fi
+	if [ -s "$WARNED" ]; then
+		tmp=$(mktemp "${TMPDIR:-/tmp}/ztsmsd.XXXXXX") || return 0
+		while read -r p; do
+			[ -n "$p" ] || continue
+			printf '%s\n' "$live" | grep -Fqx "$p" && printf '%s\n' "$p"
+		done < "$WARNED" > "$tmp"
+		if cmp -s "$tmp" "$WARNED"; then rm -f "$tmp"; else mv "$tmp" "$WARNED"; fi
+	fi
+
+	# First sight of a receiving object: record it, seeded with the SMS
+	# timestamp when MM knows it (so a days-old orphan is reported at once,
+	# while a multipart that is still arriving gets the grace period).
+	for p in $live; do
+		# Match the first TSV field exactly: /SMS/1 must not match /SMS/10.
+		if [ -s "$RECEIVING" ] && cut -f1 "$RECEIVING" | grep -Fqx "$p"; then
+			continue
+		fi
+		idx=${p##*/}
+		info=$(mmcli -m "$MM_MODEM" -s "$idx" -K 2>/dev/null)
+		storage=$(decode_escapes "$(property "$info" storage)")
+		scts=$(decode_escapes "$(property "$info" timestamp)")
+		number=$(decode_escapes "$(property "$info" number)")
+		first=$(sms_timestamp_epoch "$scts") || first=$now
+		[ "$first" -gt "$now" ] 2>/dev/null && first=$now
+		printf '%s\t%s\t%s\t%s\t%s\n' "$p" "$first" "${storage:--}" "${scts:--}" "${number:--}" >> "$RECEIVING"
+	done
+
+	# Report objects older than the threshold, once each.
+	while IFS="$(printf '\t')" read -r p first storage scts number; do
+		[ -n "$p" ] || continue
+		grep -Fqx "$p" "$WARNED" 2>/dev/null && continue
+		[ "$((now - first))" -ge "$RECEIVING_STALE_SECS" ] 2>/dev/null || continue
+		printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$p" \
+			"$storage" "$scts" "$number" >> "$STUCK_LOG" 2>/dev/null
+		log "STUCK SMS $p state=receiving age=$((now - first))s storage=$storage scts=$scts number=$number — incomplete multipart or failed WMS read; NOT deleted (see research/ugglite-sms-receive.md)"
+		printf '%s\n' "$p" >> "$WARNED"
+	done < "$RECEIVING"
+}
+
 while :; do
 	list=$(mmcli -m "$MM_MODEM" --messaging-list-sms 2>/dev/null)
 	if [ -z "$list" ]; then
@@ -145,17 +254,31 @@
